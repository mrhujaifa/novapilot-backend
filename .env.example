# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------

DATABASE_URL=postgresql://username:password@host:5432/database


# ------------------------------------------------------------------
# Authentication (Privy)
# ------------------------------------------------------------------

PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret


# ------------------------------------------------------------------
# Circle
# ------------------------------------------------------------------

CIRCLE_API_KEY=your_circle_api_key
CIRCLE_ENTITY_SECRET=your_circle_entity_secret

CIRCLE_WALLET_SET_ID=your_circle_wallet_set_id

ADMIN_CIRCLE_WALLET_ID=your_admin_wallet_id
ADMIN_CIRCLE_WALLET_ADDRESS=your_admin_wallet_address

USDC_CONTRACT_ADDRESS=your_usdc_contract_address

SWEEP_THRESHOLD_USDC=0.01


# ------------------------------------------------------------------
# AI Providers
# ------------------------------------------------------------------

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=


# ------------------------------------------------------------------
# Redis (Upstash)
# ------------------------------------------------------------------

UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token


# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------

ALLOWED_ORIGINS=http://localhost:3000

PORT=4000

NODE_ENV=development

# testnet | mainnet
CHAIN_ENV=testnet