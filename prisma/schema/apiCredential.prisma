// Creator এর original server এর auth secret।
// Consumer কখনো দেখবে না — NovaPilot proxy পেছন থেকে inject করে।
model ApiCredential {
  id    String @id @default(uuid())
  apiId String @unique

  // Example: "X-Arif-Auth", "Authorization"
  headerName String

  // AES-256 + KMS দিয়ে encrypt করে store।
  // Request forward করার সময় decrypt, কোনো log এ লেখা নিষেধ।
  encryptedHeaderValue String
  kmsKeyId             String

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  rotatedAt DateTime?

  api ApiListing @relation(fields: [apiId], references: [id])
}
