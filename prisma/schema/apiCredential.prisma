enum CredentialType {
  API_KEY
  BEARER
  BASIC
  CUSTOM
}

model ApiCredential {
  id    String @id @default(uuid())
  apiId String

  // Credential identifier — authSpec এ reference করা হয়
  name String @default("primary")

  type CredentialType @default(API_KEY)

  // AES-256 encrypt করা JSON string
  // API_KEY: {"value": "SECRET"}
  // BASIC: {"username": "user", "password": "pass"}
  // BEARER: {"token": "SECRET"}
  encryptedData String
  kmsKeyId      String

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  rotatedAt DateTime?

  api ApiListing @relation(fields: [apiId], references: [id])

  @@unique([apiId, name])
  @@index([apiId])
}
