enum NetworkEnv {
    TESTNET
    MAINNET
}

model Balance {
    id        String     @id @default(uuid())
    userId    String
    user      User       @relation(fields: [userId], references: [id])
    network   NetworkEnv
    amount    Decimal    @db.Decimal(18, 6)
    updatedAt DateTime   @updatedAt

    @@unique([userId, network])
}
