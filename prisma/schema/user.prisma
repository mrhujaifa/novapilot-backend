model User {
    id          String   @id @default(uuid())
    privyUserId String   @unique // Privy identity — শুধু login/auth-এর জন্য
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    wallets      Wallet[]
    balances     Balance[]
    deposits     Deposit[]
    usageLogs    UsageLog[]
    transactions Transaction[]
}
