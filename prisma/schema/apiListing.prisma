model ApiListing {
  id          String @id @default(uuid())
  creatorId   String
  apiName     String
  apiSlug     String @unique
  description String @db.Text
  category    String

  // Renamed: targetOriginUrl → targetBaseUrl (base URL only, no path)
  targetBaseUrl    String
  proxyEndpointUrl String

  // New: generic request + auth configuration
  requestSpec Json  @default("{}")
  authSpec    Json?

  pricingModel    ApiPricingModel  @default(PER_1K_CALLS)
  status          ApiListingStatus @default(DRAFT)
  reportCount     Int              @default(0)
  successfulCalls Int              @default(0)
  uptimePercent   Decimal          @default(100) @db.Decimal(5, 2)
  avgLatencyMs    Int              @default(0)
  network         NetworkEnv
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  creator       CreatorProfile           @relation(fields: [creatorId], references: [id])
  priceVersions ApiPriceVersion[]
  credentials   ApiCredential[] // one-to-many এখন
  consumerKeys  MarketplaceConsumerKey[]
  subscriptions ApiSubscription[]
  usageRecords  MarketplaceUsageRecord[]
  reports       ApiReport[]
  healthCheck   ApiHealthCheck?

  @@index([creatorId])
  @@index([status])
  @@index([category])
  @@index([apiSlug])
}
