model Transaction {
  id             String          @id @default(uuid())
  userId         String
  network        NetworkEnv
  type           TransactionType
  amountUsdc     Decimal         @db.Decimal(18, 6)
  balanceAfter   Decimal         @db.Decimal(18, 6)
  createdAt      DateTime        @default(now())
  depositId      String?         @unique
  usageLogId     String?         @unique
  idempotencyKey String?         @unique

  deposit                  Deposit?  @relation(fields: [depositId], references: [id])
  usageLog                 UsageLog? @relation(fields: [usageLogId], references: [id])
  user                     User      @relation(fields: [userId], references: [id])
  // Marketplace এর জন্য নতুন optional link
  marketplaceUsageRecordId String?   @unique

  @@index([userId])
  @@index([createdAt])
}
