model ChatHistory {
  id             String       @id @default(uuid())
  userId         String
  network        NetworkEnv
  modelPricingId String
  prompt         String
  response       String
  inputTokens    Int
  outputTokens   Int
  usageLogId     String       @unique
  createdAt      DateTime     @default(now())
  modelPricing   ModelPricing @relation(fields: [modelPricingId], references: [id])
  usageLog       UsageLog     @relation(fields: [usageLogId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}
