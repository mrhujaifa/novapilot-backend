model Wallet {
  id             String     @id @default(uuid())
  userId         String
  circleWalletId String     @unique
  address        String
  network        NetworkEnv
  createdAt      DateTime   @default(now())
  deposits       Deposit[]
  user           User       @relation(fields: [userId], references: [id])

  @@unique([address, network])
  @@unique([userId, network])
  @@index([userId])
}
