model Wallet {
    id             String     @id @default(uuid())
    userId         String
    user           User       @relation(fields: [userId], references: [id])
    circleWalletId String     @unique // Circle প্রতি network-এ আলাদা wallet বানায়, তাই এখানে (User-এ না)
    address        String // checksum on-chain address
    network        NetworkEnv
    createdAt      DateTime   @default(now())

    deposits Deposit[]

    @@unique([address, network])
    @@unique([userId, network]) // এক user-এর network-প্রতি একটাই Circle wallet — এটাই source of truth
    @@index([userId])
}
